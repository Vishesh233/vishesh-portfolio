# Formspree form id used by the contact form.
# Copy this file to .env, set VITE_FORMSPREE_ID to the id of your own
# Formspree form (the value from https://formspree.io/f/<id>), and restart
# the dev server. Without it the contact section shows a notice and a
# mailto: fallback instead of the form.
VITE_FORMSPREE_ID=